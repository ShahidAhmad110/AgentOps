APP_NAME=AgentOps
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://agentops:agentops@127.0.0.1:15432/agentops
DOCUMENT_STORAGE_PATH=storage/documents
MAX_DOCUMENT_SIZE_BYTES=10485760
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_LIFETIME_SECONDS=3600
SEED_ADMIN_PASSWORD=replace-with-a-secure-development-password